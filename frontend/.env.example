# Sentinel Voice - Frontend Environment Variables Example

# Backend FastAPI Gateway URL (default local development)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Optional: Enable Demo Mode toggle in UI for offline / UI evaluation
NEXT_PUBLIC_ENABLE_DEMO_MODE=true

# Application Metadata
NEXT_PUBLIC_APP_NAME=Sentinel Voice
NEXT_PUBLIC_APP_VERSION=0.1.0

