# ==============================================================================
# Sentinel Voice — Environment Configuration Template
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
DEBUG=false
APP_NAME="Sentinel Voice"
APP_VERSION=0.1.0

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration & Connection Pool Hardening
# ------------------------------------------------------------------------------
# Asynchronous connection string for SQLAlchemy / asyncpg
DATABASE_URL=postgresql+asyncpg://sentinel_user:your_secure_password@localhost:5432/sentinel_voice
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE=1800
DATABASE_POOL_PRE_PING=true
DATABASE_CONNECT_TIMEOUT=10.0

# ------------------------------------------------------------------------------
# CORS & Network Origins
# ------------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
TRUSTED_PROXIES=["127.0.0.1","::1"]

# ------------------------------------------------------------------------------
# Biometric Vector Encryption (AES-256-GCM Envelope Encryption)
# ------------------------------------------------------------------------------
# 32-byte (256-bit) Base64 or Hex Master Key decoupled from PostgreSQL database.
# Generate via: python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
SENTINEL_BIOMETRIC_ENCRYPTION_KEY=

# Local / Volume path for encrypted container payloads (.enc)
BIOMETRIC_STORE_PATH=outputs/biometric_store

# ------------------------------------------------------------------------------
# Authentication & Cryptographic Tokens
# ------------------------------------------------------------------------------
# Secret key for signing Access Tokens (HS256)
SECRET_KEY=change_this_to_a_secure_random_string_in_production_min_32_bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CSRF Protection Secret for Cookie-based Sessions
CSRF_SECRET_KEY=change_this_to_a_secure_random_csrf_key_in_production

# ------------------------------------------------------------------------------
# Authentication Abuse & Brute-Force Throttling
# ------------------------------------------------------------------------------
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_DURATION_SECONDS=900
AUTH_IP_MAX_FAILED_ATTEMPTS=10
AUTH_IP_LOCKOUT_DURATION_SECONDS=1800

# ------------------------------------------------------------------------------
# API Rate Limiting (Sliding Window: Redis / In-Memory)
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
# Storage: 'auto' (uses Redis if REDIS_URL provided, else in-memory), 'redis', or 'memory'
RATE_LIMIT_STORAGE=auto
REDIS_URL=redis://localhost:6379/0

# Configurable rate limits per endpoint
RATE_LIMIT_REGISTER="5/hour"
RATE_LIMIT_LOGIN="5/15minute"
RATE_LIMIT_REFRESH="10/15minute"
RATE_LIMIT_ENROLLMENT="5/15minute"
RATE_LIMIT_VERIFICATION="20/minute"
RATE_LIMIT_PASSWORD_CHANGE="3/hour"
RATE_LIMIT_GENERAL="100/minute"

# ------------------------------------------------------------------------------
# Biometric Resource Bounds & Concurrency Protection
# ------------------------------------------------------------------------------
MAX_AUDIO_UPLOAD_SIZE_BYTES=10485760
MAX_CONCURRENT_INFERENCES=4
INFERENCE_TIMEOUT_SECONDS=30.0

# ------------------------------------------------------------------------------
# Structured Logging, Monitoring & Documentation Exposure
# ------------------------------------------------------------------------------
# Log format: 'console' (colored text for dev) or 'json' (ISO 8601 UTC JSON for production)
LOG_FORMAT=console
LOG_LEVEL=info
EXPOSE_DOCS=true

# ------------------------------------------------------------------------------
# Audio & Verification Engine Configuration
# ------------------------------------------------------------------------------
# Calibrated operating threshold (dynamically managed in threshold_configurations table)
# Initial seed value derived from LibriSpeech Phase 5E calibration: 0.405898
DEFAULT_THRESHOLD=0.405898
SAMPLE_RATE=16000
MIN_AUDIO_DURATION_SEC=1.0
MAX_AUDIO_DURATION_SEC=60.0
